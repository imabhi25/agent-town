DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_town
REDIS_URL=redis://localhost:6379/0
# Keep server-side only. Leave empty to use the mock provider.
GEMINI_API_KEY=
GEMINI_DAILY_CAP=50
WORKER_COUNT=4
MOCK_MIN_LATENCY=0.05
MOCK_MAX_LATENCY=0.2
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
HEARTBEAT_INTERVAL=2.0
HEARTBEAT_TTL=6.0
LEASE_SECONDS=15.0
RECOVERY_INTERVAL=5.0

# --- hosted demo (see docs/DEPLOY.md) ---
# Set these in the Render dashboard (render.yaml lists them), not in a committed file. They are
# commented out here so a local run stays on the mock provider with no limits to trip over.
# LIVE_DEMO=true                  # embedded workers, quiet polling, caps, sleep when idle
# AUTO_MIGRATE=true               # a managed database starts empty: apply migrations at startup
# TRUST_FORWARDED_FOR=true        # behind Render's proxy, so per-IP limits see the real client
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
# CORS_ORIGINS=https://your-site.vercel.app    # exact https origin, no trailing slash, no "*"
# GEMINI_API_KEY=                 # server-side only; empty = mock planner only
# GEMINI_DAILY_CAP=50             # hard cap on real Gemini calls per UTC day (also set above)
# LIVE_GOALS_DAILY_CAP=30         # goals per UTC day across all visitors; 0 = unlimited
